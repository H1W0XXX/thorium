+void Socks5ProxyDatagramClientSocket::Close() {
+  connect_callback_.Reset();
+  read_callback_.Reset();
+  write_callback_.Reset();
+  read_user_buffer_ = nullptr;
+  read_user_buffer_size_ = 0;
+  read_wire_buffer_.reset();
+  write_wire_buffer_.reset();
+  control_read_buffer_.reset();
+  control_write_buffer_.reset();
+  next_state_ = State::kDisconnected;
+  if (udp_socket_) {
+    udp_socket_->Close();
+  }
+  if (control_socket_) {
+    control_socket_->Disconnect();
+  }
+}
+
