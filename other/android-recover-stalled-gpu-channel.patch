diff --git a/content/browser/gpu/browser_gpu_channel_host_factory.cc b/content/browser/gpu/browser_gpu_channel_host_factory.cc
index 187bde80d2..a1a0c08ef9 100644
--- a/content/browser/gpu/browser_gpu_channel_host_factory.cc
+++ b/content/browser/gpu/browser_gpu_channel_host_factory.cc
@@ -40,6 +40,8 @@ namespace {
 
 #if BUILDFLAG(IS_ANDROID)
 
+constexpr int kMaxGpuChannelRecoveryAttempts = 3;
+
 // This is used as the stack frame to group these timeout crashes, so avoid
 // renaming it or moving the LOG(FATAL) call.
 NOINLINE void TimedOut() {
@@ -421,13 +423,57 @@ void BrowserGpuChannelHostFactory::GpuChannelEstablished(
     EstablishRequest* request) {
   DCHECK(BrowserThread::CurrentlyOn(BrowserThread::UI));
   DCHECK(!pending_request_ || pending_request_ == request);
   gpu_channel_ = request->gpu_channel();
   pending_request_ = nullptr;
+  gpu_channel_recovery_attempts_ = 0;
   timeout_.Stop();
   if (gpu_channel_)
     GetContentClient()->SetGpuInfo(gpu_channel_->gpu_info());
 }
 
+void BrowserGpuChannelHostFactory::RecoverFromTimeout() {
+  DCHECK(BrowserThread::CurrentlyOn(BrowserThread::UI));
+#if BUILDFLAG(IS_ANDROID)
+  if (!pending_request_ || !is_visible_)
+    return;
+
+  if (gpu_channel_recovery_attempts_ >= kMaxGpuChannelRecoveryAttempts) {
+    DumpGpuStackOnProcessThread();
+    return;
+  }
+
+  ++gpu_channel_recovery_attempts_;
+  LOG(ERROR) << "GPU channel timed out; discarding the stale GPU host and "
+                "retrying (attempt "
+             << gpu_channel_recovery_attempts_ << "/"
+             << kMaxGpuChannelRecoveryAttempts << ").";
+
+  GpuProcessHost* host =
+      GpuProcessHost::Get(GPU_PROCESS_KIND_SANDBOXED, /*force_create=*/false);
+  if (host)
+    host->DumpProcessStack();
+
+  std::vector<gpu::GpuChannelEstablishedCallback> callbacks =
+      pending_request_->TakeCallbacks();
+  pending_request_->Cancel();
+  pending_request_ = nullptr;
+  CloseChannel();
+
+  // ForceShutdown() removes this host from the global host table immediately,
+  // so EstablishRequest::Create() below cannot attach to the stale Android
+  // service connection.
+  if (host)
+    host->ForceShutdown();
+
+  scoped_refptr<EstablishRequest> request = EstablishRequest::Create(
+      gpu_client_id_, gpu_client_tracing_id_, /*sync=*/false,
+      std::move(callbacks));
+  if (!request->finished())
+    pending_request_ = std::move(request);
+  RestartTimeout();
+#endif
+}
+
 void BrowserGpuChannelHostFactory::RestartTimeout() {
   DCHECK(BrowserThread::CurrentlyOn(BrowserThread::UI));
 // Only implement timeout on Android, which does not have a software fallback.
@@ -461,7 +507,9 @@ void BrowserGpuChannelHostFactory::RestartTimeout() {
 #endif
 
   timeout_.Start(FROM_HERE, base::Seconds(kGpuChannelTimeoutInSeconds),
-                 base::BindOnce(&DumpGpuStackOnProcessThread));
+                 base::BindOnce(
+                     &BrowserGpuChannelHostFactory::RecoverFromTimeout,
+                     base::Unretained(this)));
 #endif  // BUILDFLAG(IS_ANDROID)
 }
 
