# private_sync_preferences.xml inflates this class reflectively. Keep the
# class name as well as both constructors used by AndroidX preference
# inflation so the optimized APK can open PrivateSyncSettings.
-keep class androidx.preference.EditTextPreference {
    public <init>(android.content.Context);
    public <init>(android.content.Context, android.util.AttributeSet);
}
