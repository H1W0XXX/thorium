new file mode 100644
--- /dev/null
+++ b/net/quic/quic_session_pool_socks5_job.cc
@@ -0,0 +1,190 @@
+// Copyright 2026 The Thorium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/quic/quic_session_pool_socks5_job.h"
+
+#include "base/functional/bind.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/net_errors.h"
+#include "net/base/proxy_chain.h"
+#include "net/base/proxy_server.h"
+#include "net/dns/host_resolver.h"
+#include "net/quic/quic_crypto_client_config_handle.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/socks5_proxy_datagram_client_socket.h"
+#include "net/socket/transport_client_socket.h"
+
+namespace net {
+
+QuicSessionPool::Socks5Job::Socks5Job(
+    QuicSessionPool* pool,
+    quic::ParsedQuicVersion target_quic_version,
+    HostResolver* host_resolver,
+    QuicSessionAliasKey key,
+    NetworkTrafficAnnotationTag proxy_annotation_tag,
+    MultiplexedSessionCreationInitiator session_creation_initiator,
+    std::optional<ConnectionManagementConfig> connection_management_config,
+    std::unique_ptr<CryptoClientConfigHandle> client_config_handle,
+    RequestPriority priority,
+    int cert_verify_flags,
+    const NetLogWithSource& net_log)
+    : QuicSessionPool::Job::Job(
+          pool,
+          std::move(key),
+          std::move(client_config_handle),
+          priority,
+          NetLogWithSource::Make(
+              net_log.net_log(),
+              NetLogSourceType::QUIC_SESSION_POOL_PROXY_JOB)),
+      target_quic_version_(target_quic_version),
+      host_resolver_(host_resolver),
+      proxy_annotation_tag_(proxy_annotation_tag),
+      session_creation_initiator_(session_creation_initiator),
+      connection_management_config_(connection_management_config),
+      cert_verify_flags_(cert_verify_flags) {
+  const ProxyChain& proxy_chain = key_.session_key().proxy_chain();
+  CHECK(proxy_chain.is_single_proxy());
+  CHECK_EQ(proxy_chain.Last().scheme(), ProxyServer::SCHEME_SOCKS5);
+  CHECK(target_quic_version_.IsKnown());
+}
+
+QuicSessionPool::Socks5Job::~Socks5Job() = default;
+
+int QuicSessionPool::Socks5Job::Run(CompletionOnceCallback callback) {
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    callback_ = std::move(callback);
+  }
+  return rv > 0 ? OK : rv;
+}
+
+void QuicSessionPool::Socks5Job::SetRequestExpectations(
+    QuicSessionRequest* request) {
+  const bool session_creation_finished =
+      session_attempt_ && session_attempt_->session_creation_finished();
+  if (!session_creation_finished) {
+    request->ExpectQuicSessionCreation();
+  }
+}
+
+void QuicSessionPool::Socks5Job::UpdatePriority(RequestPriority old_priority,
+                                                RequestPriority new_priority) {
+  if (old_priority != new_priority && resolve_host_request_) {
+    resolve_host_request_->ChangeRequestPriority(new_priority);
+  }
+}
+
+void QuicSessionPool::Socks5Job::PopulateNetErrorDetails(
+    NetErrorDetails* details) const {
+  if (session_attempt_) {
+    session_attempt_->PopulateNetErrorDetails(details);
+  }
+}
+
+int QuicSessionPool::Socks5Job::DoLoop(int rv) {
+  do {
+    const State state = next_state_;
+    next_state_ = State::kNone;
+    switch (state) {
+      case State::kNone:
+        NOTREACHED();
+      case State::kResolveProxy:
+        rv = DoResolveProxy();
+        break;
+      case State::kResolveProxyComplete:
+        rv = DoResolveProxyComplete(rv);
+        break;
+      case State::kConnectControl:
+        rv = DoConnectControl();
+        break;
+      case State::kConnectControlComplete:
+        rv = DoConnectControlComplete(rv);
+        break;
+      case State::kAttemptSession:
+        rv = DoAttemptSession();
+        break;
+    }
+  } while (next_state_ != State::kNone && rv != ERR_IO_PENDING);
+  return rv;
+}
+
+int QuicSessionPool::Socks5Job::DoResolveProxy() {
+  next_state_ = State::kResolveProxyComplete;
+
+  HostResolver::ResolveHostParameters parameters;
+  parameters.initial_priority = priority_;
+  parameters.secure_dns_policy = key_.session_key().secure_dns_policy();
+  resolve_host_request_ = host_resolver_->CreateRequest(
+      key_.session_key().proxy_chain().Last().host_port_pair(),
+      key_.session_key().network_anonymization_key(), net_log(), parameters);
+  return resolve_host_request_->Start(
+      base::BindOnce(&Socks5Job::OnIOComplete, base::Unretained(this)));
+}
+
+int QuicSessionPool::Socks5Job::DoResolveProxyComplete(int rv) {
+  if (rv != OK) {
+    return rv;
+  }
+  if (resolve_host_request_->GetAddressResults().empty()) {
+    return ERR_NAME_NOT_RESOLVED;
+  }
+  next_state_ = State::kConnectControl;
+  return OK;
+}
+
+int QuicSessionPool::Socks5Job::DoConnectControl() {
+  next_state_ = State::kConnectControlComplete;
+  control_socket_ = pool_->client_socket_factory_->CreateTransportClientSocket(
+      resolve_host_request_->GetAddressResults(),
+      /*socket_performance_watcher=*/nullptr,
+      /*network_quality_estimator=*/nullptr, net_log().net_log(),
+      net_log().source());
+  control_socket_->ApplySocketTag(key_.session_key().socket_tag());
+  return control_socket_->Connect(
+      base::BindOnce(&Socks5Job::OnIOComplete, base::Unretained(this)));
+}
+
+int QuicSessionPool::Socks5Job::DoConnectControlComplete(int rv) {
+  if (rv != OK) {
+    return rv;
+  }
+  rv = control_socket_->GetPeerAddress(&proxy_peer_endpoint_);
+  if (rv != OK) {
+    return rv;
+  }
+  next_state_ = State::kAttemptSession;
+  return OK;
+}
+
+int QuicSessionPool::Socks5Job::DoAttemptSession() {
+  auto proxy_datagram_socket =
+      std::make_unique<Socks5ProxyDatagramClientSocket>(
+          std::move(control_socket_),
+          pool_->CreateSocket(net_log().net_log(), net_log().source()),
+          HostPortPair::FromSchemeHostPort(key_.destination()),
+          proxy_annotation_tag_, net_log());
+
+  session_attempt_ = std::make_unique<QuicSessionAttempt>(
+      this, proxy_peer_endpoint_, target_quic_version_, cert_verify_flags_,
+      std::move(proxy_datagram_socket), session_creation_initiator_,
+      connection_management_config_);
+  return session_attempt_->Start(
+      base::BindOnce(&Socks5Job::OnSessionAttemptComplete, GetWeakPtr()));
+}
+
+void QuicSessionPool::Socks5Job::OnIOComplete(int rv) {
+  rv = DoLoop(rv);
+  if (rv != ERR_IO_PENDING && !callback_.is_null()) {
+    std::move(callback_).Run(rv);
+  }
+}
+
+void QuicSessionPool::Socks5Job::OnSessionAttemptComplete(int rv) {
+  CHECK_NE(rv, ERR_IO_PENDING);
+  if (!callback_.is_null()) {
+    std::move(callback_).Run(rv);
+  }
+}
+
+}  // namespace net
