+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return StartConnect(ConnectNetworkMode::kDefault,
+                      handles::kInvalidNetworkHandle, std::move(callback));
+}
+
+int Socks5ProxyDatagramClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return StartConnect(ConnectNetworkMode::kSpecific, network,
+                      std::move(callback));
+}
+
+int Socks5ProxyDatagramClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return StartConnect(ConnectNetworkMode::kExplicitDefault,
+                      handles::kInvalidNetworkHandle, std::move(callback));
+}
+
+int Socks5ProxyDatagramClientSocket::StartConnect(
+    ConnectNetworkMode mode,
+    handles::NetworkHandle network,
+    CompletionOnceCallback callback) {
+  CHECK_EQ(next_state_, State::kDisconnected);
+  CHECK(connect_callback_.is_null());
+  if (!control_socket_->IsConnected()) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  if (destination_.host().empty() || destination_.host().size() > 255 ||
+      destination_.port() == 0) {
+    return ERR_ADDRESS_INVALID;
+  }
+
+  connect_network_mode_ = mode;
+  connect_network_ = network;
+  next_state_ = State::kGreetWrite;
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    connect_callback_ = std::move(callback);
+  }
+  return rv;
+}
+
+int Socks5ProxyDatagramClientSocket::DoLoop(int result) {
+  while (result != ERR_IO_PENDING &&
+         next_state_ != State::kDisconnected &&
+         next_state_ != State::kConnected) {
+    State state = next_state_;
+    next_state_ = State::kDisconnected;
+    switch (state) {
+      case State::kGreetWrite:
+        result = DoGreetWrite();
+        break;
+      case State::kGreetWriteComplete:
+        result = DoGreetWriteComplete(result);
+        break;
+      case State::kGreetRead:
+        result = DoGreetRead();
+        break;
+      case State::kGreetReadComplete:
+        result = DoGreetReadComplete(result);
+        break;
+      case State::kAssociateWrite:
+        result = DoAssociateWrite();
+        break;
+      case State::kAssociateWriteComplete:
+        result = DoAssociateWriteComplete(result);
+        break;
+      case State::kAssociateRead:
+        result = DoAssociateRead();
+        break;
+      case State::kAssociateReadComplete:
+        result = DoAssociateReadComplete(result);
+        break;
+      case State::kUdpConnect:
+        result = DoUdpConnect();
+        break;
+      case State::kUdpConnectComplete:
+        result = DoUdpConnectComplete(result);
+        break;
+      case State::kDisconnected:
+      case State::kConnected:
+        NOTREACHED();
+    }
+  }
+  return result;
+}
+
+int Socks5ProxyDatagramClientSocket::DoGreetWrite() {
+  if (!control_write_buffer_) {
+    control_write_buffer_ =
+        MakeDrainableBuffer({kSocksVersion, 0x01, kNoAuthentication});
+  }
+  next_state_ = State::kGreetWriteComplete;
+  return control_socket_->Write(control_write_buffer_.get(),
+                                control_write_buffer_->BytesRemaining(),
+                                base::BindOnce(
+                                    &Socks5ProxyDatagramClientSocket::
+                                        OnConnectIOComplete,
+                                    base::Unretained(this)),
+                                traffic_annotation_);
+}
+
+int Socks5ProxyDatagramClientSocket::DoGreetWriteComplete(int result) {
+  if (result <= 0) {
+    return result == 0 ? ERR_CONNECTION_CLOSED : result;
+  }
+  control_write_buffer_->DidConsume(result);
+  if (control_write_buffer_->BytesRemaining() != 0) {
+    next_state_ = State::kGreetWrite;
+    return OK;
+  }
+  control_write_buffer_.reset();
+  control_read_buffer_ = base::MakeRefCounted<GrowableIOBuffer>();
+  control_read_buffer_->SetCapacity(2);
+  next_state_ = State::kGreetRead;
+  return OK;
+}
+
+int Socks5ProxyDatagramClientSocket::DoGreetRead() {
+  next_state_ = State::kGreetReadComplete;
+  return control_socket_->Read(
+      control_read_buffer_.get(), control_read_buffer_->RemainingCapacity(),
+      base::BindOnce(
+          &Socks5ProxyDatagramClientSocket::OnConnectIOComplete,
+          base::Unretained(this)));
+}
+
+int Socks5ProxyDatagramClientSocket::DoGreetReadComplete(int result) {
+  if (result <= 0) {
+    return result == 0 ? ERR_CONNECTION_CLOSED : result;
+  }
+  control_read_buffer_->set_offset(control_read_buffer_->offset() + result);
+  if (control_read_buffer_->RemainingCapacity() != 0) {
+    next_state_ = State::kGreetRead;
+    return OK;
+  }
+  const auto response = control_read_buffer_->span_before_offset();
+  if (response[0] != kSocksVersion || response[1] != kNoAuthentication) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buffer_.reset();
+  next_state_ = State::kAssociateWrite;
+  return OK;
+}
+
+int Socks5ProxyDatagramClientSocket::DoAssociateWrite() {
+  if (!control_write_buffer_) {
+    // Request a relay for an unspecified IPv4 client address and port. The
+    // server returns the actual UDP relay endpoint in its reply.
+    control_write_buffer_ = MakeDrainableBuffer(
+        {kSocksVersion, kUdpAssociate, kReserved, kAddressTypeIpv4,
+         0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+  }
+  next_state_ = State::kAssociateWriteComplete;
+  return control_socket_->Write(control_write_buffer_.get(),
+                                control_write_buffer_->BytesRemaining(),
+                                base::BindOnce(
+                                    &Socks5ProxyDatagramClientSocket::
+                                        OnConnectIOComplete,
+                                    base::Unretained(this)),
+                                traffic_annotation_);
+}
+
+int Socks5ProxyDatagramClientSocket::DoAssociateWriteComplete(int result) {
+  if (result <= 0) {
+    return result == 0 ? ERR_CONNECTION_CLOSED : result;
+  }
+  control_write_buffer_->DidConsume(result);
+  if (control_write_buffer_->BytesRemaining() != 0) {
+    next_state_ = State::kAssociateWrite;
+    return OK;
+  }
+  control_write_buffer_.reset();
+  control_read_buffer_ = base::MakeRefCounted<GrowableIOBuffer>();
+  control_read_buffer_->SetCapacity(kInitialAssociateReplySize);
+  next_state_ = State::kAssociateRead;
+  return OK;
+}
+
+int Socks5ProxyDatagramClientSocket::DoAssociateRead() {
+  next_state_ = State::kAssociateReadComplete;
+  return control_socket_->Read(
+      control_read_buffer_.get(), control_read_buffer_->RemainingCapacity(),
+      base::BindOnce(
+          &Socks5ProxyDatagramClientSocket::OnConnectIOComplete,
+          base::Unretained(this)));
+}
+
+int Socks5ProxyDatagramClientSocket::DoAssociateReadComplete(int result) {
+  if (result <= 0) {
+    return result == 0 ? ERR_CONNECTION_CLOSED : result;
+  }
+  control_read_buffer_->set_offset(control_read_buffer_->offset() + result);
+  auto response = control_read_buffer_->span_before_offset();
+
+  if (response.size() < kInitialAssociateReplySize) {
+    next_state_ = State::kAssociateRead;
+    return OK;
+  }
+  if (response[0] != kSocksVersion || response[1] != 0x00 ||
+      response[2] != kReserved) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  size_t address_offset = 4;
+  size_t address_size = 0;
+  switch (response[3]) {
+    case kAddressTypeIpv4:
+      address_size = 4;
+      break;
+    case kAddressTypeIpv6:
+      address_size = 16;
+      break;
+    case kAddressTypeDomain:
+      // SOCKS5 permits a domain in BND.ADDR, but using one here would require
+      // a second asynchronous resolution after the control handshake. Most
+      // servers return an IP endpoint. Fail cleanly rather than leaking a
+      // direct destination connection.
+      return ERR_ADDRESS_INVALID;
+    default:
+      return ERR_ADDRESS_INVALID;
+  }
+
+  associate_reply_size_ = address_offset + address_size + 2;
+  const int associate_reply_size =
+      base::checked_cast<int>(associate_reply_size_);
+  if (control_read_buffer_->capacity() < associate_reply_size) {
+    control_read_buffer_->SetCapacity(associate_reply_size);
+  }
+  if (control_read_buffer_->offset() < associate_reply_size) {
+    next_state_ = State::kAssociateRead;
+    return OK;
+  }
+
+  response = control_read_buffer_->span_before_offset();
+  IPAddress relay_address(response.subspan(address_offset, address_size));
+  const size_t port_offset = address_offset + address_size;
+  const uint16_t relay_port =
+      static_cast<uint16_t>((response[port_offset] << 8) |
+                            response[port_offset + 1]);
+  if (relay_port == 0) {
+    return ERR_ADDRESS_INVALID;
+  }
+
+  if (relay_address.IsZero()) {
+    IPEndPoint control_peer;
+    int rv = control_socket_->GetPeerAddress(&control_peer);
+    if (rv != OK) {
+      return rv;
+    }
+    relay_address = control_peer.address();
+  }
+  relay_endpoint_ = IPEndPoint(std::move(relay_address), relay_port);
+  control_read_buffer_.reset();
+  next_state_ = State::kUdpConnect;
+  return OK;
+}
+
+int Socks5ProxyDatagramClientSocket::DoUdpConnect() {
+  next_state_ = State::kUdpConnectComplete;
+  auto callback = base::BindOnce(
+      &Socks5ProxyDatagramClientSocket::OnConnectIOComplete,
+      base::Unretained(this));
+  switch (connect_network_mode_) {
+    case ConnectNetworkMode::kDefault:
+      return udp_socket_->ConnectAsync(relay_endpoint_, std::move(callback));
+    case ConnectNetworkMode::kExplicitDefault:
+      return udp_socket_->ConnectUsingDefaultNetworkAsync(
+          relay_endpoint_, std::move(callback));
+    case ConnectNetworkMode::kSpecific:
+      return udp_socket_->ConnectUsingNetworkAsync(
+          connect_network_, relay_endpoint_, std::move(callback));
+  }
+  NOTREACHED();
+}
+
+int Socks5ProxyDatagramClientSocket::DoUdpConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  next_state_ = State::kConnected;
+  return OK;
+}
+
+void Socks5ProxyDatagramClientSocket::OnConnectIOComplete(int result) {
+  result = DoLoop(result);
+  if (result != ERR_IO_PENDING && !connect_callback_.is_null()) {
+    if (result != OK) {
+      next_state_ = State::kDisconnected;
+    }
+    std::move(connect_callback_).Run(result);
+  }
+}
+
+handles::NetworkHandle
+Socks5ProxyDatagramClientSocket::GetBoundNetwork() const {
