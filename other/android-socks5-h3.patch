+#ifndef NET_SOCKET_SOCKS5_PROXY_DATAGRAM_CLIENT_SOCKET_H_
+#define NET_SOCKET_SOCKS5_PROXY_DATAGRAM_CLIENT_SOCKET_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "net/base/completion_once_callback.h"
+#include "net/base/host_port_pair.h"
