+int Socks5ProxyDatagramClientSocket::SetReceiveBufferSize(int32_t size) {
+  return udp_socket_->SetReceiveBufferSize(size);
+}
+
+int Socks5ProxyDatagramClientSocket::SetSendBufferSize(int32_t size) {
+  return udp_socket_->SetSendBufferSize(size);
+}
