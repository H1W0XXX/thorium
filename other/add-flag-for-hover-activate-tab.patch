diff --git a/chrome/browser/ui/views/tabs/tab.cc b/chrome/browser/ui/views/tabs/tab.cc
index 49f0b318c36a8..f1a5ae922e959 100644
--- a/chrome/browser/ui/views/tabs/tab.cc
+++ b/chrome/browser/ui/views/tabs/tab.cc
@@ -773,9 +773,19 @@ void Tab::OnMouseMoved(const ui::MouseEvent& event) {
 
 void Tab::OnMouseEntered(const ui::MouseEvent& event) {
   MaybeUpdateHoverStatus(event);
+
+  if (base::FeatureList::IsEnabled(features::kHoverActivateTab) &&
+      !IsActive()) {
+    hover_activate_timer_.Start(
+        FROM_HERE, base::Milliseconds(features::kHoverActivateTabDelayMs.Get()),
+        base::BindOnce(&Tab::OnHoverActivateTimeout,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
 }
 
 void Tab::OnMouseExited(const ui::MouseEvent& event) {
+  hover_activate_timer_.Stop();
+
   if (!mouse_hovered_) {
     return;
   }
@@ -783,6 +793,14 @@ void Tab::OnMouseExited(const ui::MouseEvent& event) {
   controller_->HideHover(this, TabStyle::HideHoverStyle::kGradual);
 }
 
+void Tab::OnHoverActivateTimeout() {
+  if (!IsActive() && mouse_hovered_) {
+    ui::MouseEvent synthetic_event(ui::EventType::kMouseMoved, gfx::Point(),
+                                   gfx::Point(), base::TimeTicks::Now(), 0, 0);
+    controller_->SelectTab(this, synthetic_event);
+  }
+}
+
 void Tab::OnGestureEvent(ui::GestureEvent* event) {
   controller_->UpdateHoverCard(nullptr,
                                TabSlotController::HoverCardUpdateType::kEvent);
