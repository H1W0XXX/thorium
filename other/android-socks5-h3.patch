+constexpr uint8_t kSocksVersion = 0x05;
+constexpr uint8_t kNoAuthentication = 0x00;
+constexpr uint8_t kUdpAssociate = 0x03;
+constexpr uint8_t kReserved = 0x00;
+constexpr uint8_t kAddressTypeIpv4 = 0x01;
+constexpr uint8_t kAddressTypeDomain = 0x03;
+constexpr uint8_t kAddressTypeIpv6 = 0x04;
+constexpr size_t kInitialAssociateReplySize = 5;
+constexpr size_t kMaxSocksUdpHeaderSize = 4 + 1 + 255 + 2;
+
+scoped_refptr<DrainableIOBuffer> MakeDrainableBuffer(
+    std::vector<uint8_t> bytes) {
+  auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(bytes));
+  const size_t size = buffer->size();
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer),
+                                                 size);
+}
+
+}  // namespace
+
+Socks5ProxyDatagramClientSocket::Socks5ProxyDatagramClientSocket(
+    std::unique_ptr<StreamSocket> control_socket,
+    std::unique_ptr<DatagramClientSocket> udp_socket,
+    HostPortPair destination,
+    NetworkTrafficAnnotationTag traffic_annotation,
+    const NetLogWithSource& source_net_log)
+    : control_socket_(std::move(control_socket)),
+      udp_socket_(std::move(udp_socket)),
+      destination_(std::move(destination)),
+      traffic_annotation_(traffic_annotation),
+      net_log_(NetLogWithSource::Make(source_net_log.net_log(),
+                                      NetLogSourceType::SOCKET)) {
+  CHECK(control_socket_);
+  CHECK(udp_socket_);
+  net_log_.BeginEventReferencingSource(NetLogEventType::SOCKET_ALIVE,
+                                       source_net_log.source());
+}
+
+Socks5ProxyDatagramClientSocket::~Socks5ProxyDatagramClientSocket() {
+  Close();
+  net_log_.EndEvent(NetLogEventType::SOCKET_ALIVE);
+}
+
+int Socks5ProxyDatagramClientSocket::Connect(const IPEndPoint& address) {
+  return ERR_NOT_IMPLEMENTED;
+}
