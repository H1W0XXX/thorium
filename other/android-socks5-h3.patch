+// Copyright 2026 The Thorium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/socket/socks5_proxy_datagram_client_socket.h"
+
+#include <memory>
+#include <string>
+
+#include "net/base/address_list.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/test_completion_callback.h"
+#include "net/log/net_log.h"
+#include "net/log/net_log_source_type.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/socket_test_util.h"
+#include "net/test/gtest_util.h"
+#include "net/test/test_with_task_environment.h"
+#include "net/traffic_annotation/network_traffic_annotation_test_helper.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+
+namespace {
+
+using test::IsError;
+using test::IsOk;
+
+std::string Bytes(std::initializer_list<uint8_t> bytes) {
+  return std::string(reinterpret_cast<const char*>(bytes.begin()),
+                     bytes.size());
+}
+
+class Socks5ProxyDatagramClientSocketTest : public TestWithTaskEnvironment {
+ protected:
+  std::unique_ptr<StreamSocket> CreateConnectedControlSocket(
+      SocketDataProvider* data) {
+    AddressList addresses =
+        AddressList::CreateFromIPAddress(IPAddress(192, 0, 2, 10), 1080);
+    auto socket = std::make_unique<MockTCPClientSocket>(
+        addresses, NetLog::Get(), data);
+    TestCompletionCallback callback;
+    EXPECT_THAT(socket->Connect(callback.callback()), IsError(ERR_IO_PENDING));
+    EXPECT_THAT(callback.WaitForResult(), IsOk());
+    return socket;
+  }
+
+  NetLogWithSource source_net_log_{NetLogWithSource::Make(
+      NetLog::Get(), NetLogSourceType::SOCKET)};
+};
+
+TEST_F(Socks5ProxyDatagramClientSocketTest, HandshakeWriteAndRead) {
+  const std::string greet_request = Bytes({0x05, 0x01, 0x00});
+  const std::string greet_response = Bytes({0x05, 0x00});
+  const std::string associate_request =
+      Bytes({0x05, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+  const std::string associate_response =
+      Bytes({0x05, 0x00, 0x00, 0x01, 198, 51, 100, 7, 0x14, 0xE9});
+
+  MockRead control_reads[] = {MockRead(SYNCHRONOUS, greet_response),
+                              MockRead(SYNCHRONOUS, associate_response)};
+  MockWrite control_writes[] = {MockWrite(SYNCHRONOUS, greet_request),
+                                MockWrite(SYNCHRONOUS, associate_request)};
+  StaticSocketDataProvider control_data(control_reads, control_writes);
+
+  const std::string payload = "quic packet";
+  std::string expected_write =
+      Bytes({0x00, 0x00, 0x00, 0x03, 0x0B});
+  expected_write.append("example.com");
+  expected_write.append(Bytes({0x01, 0xBB}));
+  expected_write.append(payload);
+
+  std::string udp_reply =
+      Bytes({0x00, 0x00, 0x00, 0x01, 203, 0, 113, 9, 0x01, 0xBB});
+  udp_reply.append(payload);
+  MockRead udp_reads[] = {MockRead(SYNCHRONOUS, udp_reply)};
+  MockWrite udp_writes[] = {MockWrite(SYNCHRONOUS, expected_write)};
+  StaticSocketDataProvider udp_data(udp_reads, udp_writes);
+  udp_data.set_connect_data(MockConnect(SYNCHRONOUS, OK));
+
+  auto socket = std::make_unique<Socks5ProxyDatagramClientSocket>(
+      CreateConnectedControlSocket(&control_data),
+      std::make_unique<MockUDPClientSocket>(&udp_data),
+      HostPortPair("example.com", 443), TRAFFIC_ANNOTATION_FOR_TESTS,
+      source_net_log_);
+
+  TestCompletionCallback connect_callback;
+  EXPECT_THAT(socket->ConnectAsync(IPEndPoint(),
+                                   connect_callback.callback()),
+              IsOk());
+
+  IPEndPoint peer;
+  EXPECT_THAT(socket->GetPeerAddress(&peer), IsOk());
+  EXPECT_EQ(peer, IPEndPoint(IPAddress(198, 51, 100, 7), 5353));
+
+  auto write_buffer = base::MakeRefCounted<StringIOBuffer>(payload);
+  TestCompletionCallback write_callback;
+  EXPECT_EQ(socket->Write(write_buffer.get(), payload.size(),
+                          write_callback.callback(),
+                          TRAFFIC_ANNOTATION_FOR_TESTS),
+            static_cast<int>(payload.size()));
+
+  auto read_buffer = base::MakeRefCounted<IOBufferWithSize>(128);
+  TestCompletionCallback read_callback;
+  EXPECT_EQ(socket->Read(read_buffer.get(), read_buffer->size(),
+                         read_callback.callback()),
+            static_cast<int>(payload.size()));
+  EXPECT_EQ(std::string(read_buffer->data(), payload.size()), payload);
+
+  EXPECT_TRUE(control_data.AllReadDataConsumed());
+  EXPECT_TRUE(control_data.AllWriteDataConsumed());
+  EXPECT_TRUE(udp_data.AllReadDataConsumed());
+  EXPECT_TRUE(udp_data.AllWriteDataConsumed());
+}
+
+TEST_F(Socks5ProxyDatagramClientSocketTest, RejectsAuthenticationRequest) {
+  const std::string greet_request = Bytes({0x05, 0x01, 0x00});
+  const std::string auth_required = Bytes({0x05, 0x02});
+  MockRead control_reads[] = {MockRead(SYNCHRONOUS, auth_required)};
+  MockWrite control_writes[] = {MockWrite(SYNCHRONOUS, greet_request)};
+  StaticSocketDataProvider control_data(control_reads, control_writes);
+  StaticSocketDataProvider udp_data;
+  udp_data.set_connect_data(MockConnect(SYNCHRONOUS, OK));
+
+  auto socket = std::make_unique<Socks5ProxyDatagramClientSocket>(
+      CreateConnectedControlSocket(&control_data),
+      std::make_unique<MockUDPClientSocket>(&udp_data),
+      HostPortPair("example.com", 443), TRAFFIC_ANNOTATION_FOR_TESTS,
+      source_net_log_);
+
+  TestCompletionCallback callback;
+  EXPECT_THAT(socket->ConnectAsync(IPEndPoint(), callback.callback()),
+              IsError(ERR_SOCKS_CONNECTION_FAILED));
+  EXPECT_TRUE(control_data.AllReadDataConsumed());
+  EXPECT_TRUE(control_data.AllWriteDataConsumed());
+}
+
+}  // namespace
+
+}  // namespace net
