+void BrowserGpuChannelHostFactory::RecoverFromTimeout() {
+  DCHECK(BrowserThread::CurrentlyOn(BrowserThread::UI));
+#if BUILDFLAG(IS_ANDROID)
+  if (!pending_request_ || !is_visible_)
+    return;
+
+  if (gpu_channel_recovery_attempts_ >= kMaxGpuChannelRecoveryAttempts) {
+    DumpGpuStackOnProcessThread();
+    return;
+  }
+
+  ++gpu_channel_recovery_attempts_;
+  LOG(ERROR) << "GPU channel timed out; discarding the stale GPU host and "
+                "retrying (attempt "
+             << gpu_channel_recovery_attempts_ << "/"
+             << kMaxGpuChannelRecoveryAttempts << ").";
+
+  GpuProcessHost* host =
+      GpuProcessHost::Get(GPU_PROCESS_KIND_SANDBOXED, /*force_create=*/false);
+  if (host)
+    host->DumpProcessStack();
+
+  std::vector<gpu::GpuChannelEstablishedCallback> callbacks =
+      pending_request_->TakeCallbacks();
+  pending_request_->Cancel();
+  pending_request_ = nullptr;
+  CloseChannel();
+
+  // ForceShutdown() removes this host from the global host table immediately,
+  // so EstablishRequest::Create() below cannot attach to the stale Android
+  // service connection.
+  if (host)
+    host->ForceShutdown();
+
+  scoped_refptr<EstablishRequest> request = EstablishRequest::Create(
+      gpu_client_id_, gpu_client_tracing_id_, /*sync=*/false,
+      std::move(callbacks));
+  if (!request->finished())
+    pending_request_ = std::move(request);
+  RestartTimeout();
+#endif
 }
 
