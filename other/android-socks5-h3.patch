+
+int Socks5ProxyDatagramClientSocket::Read(IOBuffer* buf,
+                                          int buf_len,
+                                          CompletionOnceCallback callback) {
+  CHECK(read_callback_.is_null());
+  CHECK(!read_user_buffer_);
+  if (next_state_ != State::kConnected) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  if (buf_len <= 0 ||
+      buf_len > std::numeric_limits<int>::max() -
+                    static_cast<int>(kMaxSocksUdpHeaderSize)) {
+    return ERR_INVALID_ARGUMENT;
+  }
+
+  read_user_buffer_ = buf;
+  read_user_buffer_size_ = buf_len;
+  read_wire_buffer_ = base::MakeRefCounted<IOBufferWithSize>(
+      buf_len + static_cast<int>(kMaxSocksUdpHeaderSize));
+  int rv = udp_socket_->Read(
+      read_wire_buffer_.get(), read_wire_buffer_->size(),
+      base::BindOnce(&Socks5ProxyDatagramClientSocket::OnReadComplete,
+                     base::Unretained(this)));
+  if (rv == ERR_IO_PENDING) {
+    read_callback_ = std::move(callback);
+    return rv;
+  }
+  rv = ConsumeReadResult(rv);
+  read_user_buffer_ = nullptr;
+  read_user_buffer_size_ = 0;
+  read_wire_buffer_.reset();
+  return rv;
+}
+
+void Socks5ProxyDatagramClientSocket::OnReadComplete(int result) {
+  result = ConsumeReadResult(result);
+  read_user_buffer_ = nullptr;
+  read_user_buffer_size_ = 0;
+  read_wire_buffer_.reset();
+  std::move(read_callback_).Run(result);
+}
+
+int Socks5ProxyDatagramClientSocket::ConsumeReadResult(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result < 4) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  const auto packet = read_wire_buffer_->span().first(
+      base::checked_cast<size_t>(result));
+  if (packet[0] != 0 || packet[1] != 0 || packet[2] != 0) {
+    // Fragmented SOCKS UDP packets are not supported. QUIC performs its own
+    // packetization and should not require SOCKS-level fragmentation.
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  size_t header_size = 0;
+  switch (packet[3]) {
+    case kAddressTypeIpv4:
+      header_size = 4 + 4 + 2;
+      break;
+    case kAddressTypeIpv6:
+      header_size = 4 + 16 + 2;
+      break;
+    case kAddressTypeDomain:
+      if (packet.size() < 5) {
+        return ERR_SOCKS_CONNECTION_FAILED;
+      }
+      header_size = 4 + 1 + packet[4] + 2;
+      break;
+    default:
+      return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (packet.size() < header_size) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  const size_t payload_size = packet.size() - header_size;
+  if (payload_size > static_cast<size_t>(read_user_buffer_size_)) {
+    return ERR_MSG_TOO_BIG;
+  }
+  read_user_buffer_->span().copy_prefix_from(packet.subspan(header_size));
+  return static_cast<int>(payload_size);
+}
+
+int Socks5ProxyDatagramClientSocket::Write(
+    IOBuffer* buf,
+    int buf_len,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  CHECK(write_callback_.is_null());
+  if (next_state_ != State::kConnected) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  if (buf_len < 0) {
+    return ERR_INVALID_ARGUMENT;
+  }
+
+  std::vector<uint8_t> header = BuildUdpHeader();
+  if (header.empty()) {
+    return ERR_ADDRESS_INVALID;
+  }
+  if (header.size() + static_cast<size_t>(buf_len) >
+      static_cast<size_t>(std::numeric_limits<int>::max())) {
+    return ERR_MSG_TOO_BIG;
+  }
+
+  write_payload_size_ = buf_len;
+  write_wire_buffer_ = base::MakeRefCounted<IOBufferWithSize>(
+      static_cast<int>(header.size()) + buf_len);
+  auto wire_span = write_wire_buffer_->span();
+  wire_span.first(header.size()).copy_from(base::span(header));
+  wire_span
+      .subspan(header.size(), base::checked_cast<size_t>(buf_len))
+      .copy_from(
+          buf->span().first(base::checked_cast<size_t>(buf_len)));
+
+  int rv = udp_socket_->Write(
+      write_wire_buffer_.get(), write_wire_buffer_->size(),
+      base::BindOnce(&Socks5ProxyDatagramClientSocket::OnWriteComplete,
+                     base::Unretained(this)),
+      traffic_annotation);
+  if (rv == ERR_IO_PENDING) {
+    write_callback_ = std::move(callback);
+    return rv;
+  }
+  rv = TranslateWriteResult(rv);
+  write_wire_buffer_.reset();
+  write_payload_size_ = 0;
+  return rv;
+}
+
+void Socks5ProxyDatagramClientSocket::OnWriteComplete(int result) {
+  result = TranslateWriteResult(result);
+  write_wire_buffer_.reset();
+  write_payload_size_ = 0;
+  std::move(write_callback_).Run(result);
+}
+
+int Socks5ProxyDatagramClientSocket::TranslateWriteResult(int result) const {
+  if (result < 0) {
+    return result;
+  }
+  if (!write_wire_buffer_ || result != write_wire_buffer_->size()) {
+    return ERR_FAILED;
+  }
+  return write_payload_size_;
+}
+
+std::vector<uint8_t>
+Socks5ProxyDatagramClientSocket::BuildUdpHeader() const {
+  const std::string& host = destination_.host();
+  if (host.empty() || host.size() > 255) {
+    return {};
+  }
+  std::vector<uint8_t> header;
+  header.reserve(4 + 1 + host.size() + 2);
+  header.insert(header.end(), {0x00, 0x00, 0x00, kAddressTypeDomain});
+  header.push_back(static_cast<uint8_t>(host.size()));
+  header.insert(header.end(), host.begin(), host.end());
+  const auto port = base::U16ToBigEndian(destination_.port());
+  header.insert(header.end(), port.begin(), port.end());
+  return header;
+}
